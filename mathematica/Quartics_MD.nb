Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", "OPTIMIZATION", " ", "*)"}], "\[IndentingNewLine]", 
  RowBox[{"(*", 
   RowBox[{
    RowBox[{"If", "[", 
     RowBox[{
      RowBox[{"AllTrue", "[", 
       RowBox[{"HessianEigenvalues", ",", 
        RowBox[{
         RowBox[{"#", "\[GreaterEqual]", "0"}], "&"}]}], "]"}], ",", 
      "\[IndentingNewLine]", 
      RowBox[{"(*", " ", 
       RowBox[{
        RowBox[{"Already", " ", "at", " ", "a", " ", "minimum"}], ",", " ", 
        RowBox[{"skip", " ", "optimization"}]}], " ", "*)"}], 
      "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"Print", "[", "\"\<Origin is a local minimum.\>\"", "]"}], ";",
        "\[IndentingNewLine]", 
       RowBox[{"Export", "[", 
        RowBox[{
         RowBox[{"polyoutfolder", "<>", "\"\</minloc.dat\>\""}], ",", 
         "\[Theta]val", ",", "\"\<csv\>\""}], "]"}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"Export", "[", 
        RowBox[{
         RowBox[{"polyoutfolder", "<>", "\"\</min.dat\>\""}], ",", 
         "PotentialValue", ",", "\"\<csv\>\""}], "]"}], ";"}], 
      "\[IndentingNewLine]", ",", "\[IndentingNewLine]", 
      RowBox[{"(*", " ", 
       RowBox[{
        RowBox[{"Not", " ", "a", " ", "minimum"}], ",", " ", "optimize"}], 
       " ", "*)"}], "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{
       "Print", "[", "\"\<Origin is not a local minimum. Optimizing...\>\"", 
        "]"}], ";", "\[IndentingNewLine]", 
       RowBox[{"NumNegEigValsBefore", "=", 
        RowBox[{"Length", "[", 
         RowBox[{"Select", "[", 
          RowBox[{"HessianEigenvalues", ",", 
           RowBox[{
            RowBox[{"#", "<", "0"}], "&"}]}], "]"}], "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"Off", "[", 
        RowBox[{"FindMinimum", "::", "lstol"}], "]"}], ";", " ", 
       RowBox[{"(*", " ", 
        RowBox[{"Turn", " ", "off", " ", "convergence", " ", "error", " ", 
         RowBox[{"message", ".", " ", "Will"}], " ", "check", " ", "Hessian", 
         " ", "directly", " ", 
         RowBox[{"instead", "."}]}], " ", "*)"}], "\[IndentingNewLine]", 
       RowBox[{"LocalMinimum", "=", 
        RowBox[{"FindMinimum", "[", 
         RowBox[{"Potential", ",", 
          RowBox[{"Table", "[", 
           RowBox[{
            RowBox[{"{", 
             RowBox[{
              RowBox[{"\[Theta]var", "[", 
               RowBox[{"[", "ii", "]"}], "]"}], ",", 
              RowBox[{"SetPrecision", "[", 
               RowBox[{
                RowBox[{"RandomReal", "[", 
                 RowBox[{"{", 
                  RowBox[{
                   RowBox[{"-", "0.1"}], ",", "0.1"}], "}"}], "]"}], ",", 
                "$MinPrecision"}], "]"}]}], "}"}], ",", 
            RowBox[{"{", 
             RowBox[{"ii", ",", "h11"}], "}"}]}], "]"}], ",", 
          RowBox[{"Method", "\[Rule]", "\"\<QuasiNewton\>\""}], ",", " ", 
          RowBox[{"WorkingPrecision", "\[Rule]", "$MinPrecision"}], ",", 
          RowBox[{"MaxIterations", "\[Rule]", "50000"}], ",", " ", 
          RowBox[{"PrecisionGoal", "\[Rule]", 
           RowBox[{"(", 
            RowBox[{"$MinPrecision", "/", "2"}], ")"}]}], ",", " ", 
          RowBox[{"AccuracyGoal", "\[Rule]", " ", 
           RowBox[{"(", 
            RowBox[{"$MinPrecision", "/", "2"}], ")"}]}]}], "]"}]}], ";", 
       "\[IndentingNewLine]", "\[IndentingNewLine]", 
       RowBox[{"(*", " ", 
        RowBox[{
        "Test", " ", "whether", " ", "optimization", " ", "is", " ", 
         "successful"}], " ", "*)"}], "\[IndentingNewLine]", 
       RowBox[{"(*", " ", 
        RowBox[{"Compute", " ", "Jacobian", " ", "Values"}], " ", "*)"}], 
       "\[IndentingNewLine]", 
       RowBox[{"JacobianValuesRaw", "=", 
        RowBox[{"PotentialJacobian", "/.", 
         RowBox[{"LocalMinimum", "[", 
          RowBox[{"[", "2", "]"}], "]"}]}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"(*", " ", 
        RowBox[{"Compute", " ", "Hessian", " ", "Eigenvalues"}], " ", "*)"}], 
       "\[IndentingNewLine]", 
       RowBox[{"HessianValues", "=", 
        RowBox[{"PotentialHessian", "/.", 
         RowBox[{"LocalMinimum", "[", 
          RowBox[{"[", "2", "]"}], "]"}]}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"HessianEigenvaluesRaw", "=", 
        RowBox[{"Eigenvalues", "[", "HessianValues", "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"(*", " ", 
        RowBox[{"Clean", " ", "up", " ", "precision", " ", "errors"}], " ", 
        "*)"}], "\[IndentingNewLine]", 
       RowBox[{"HessianEigenvalues", "=", 
        RowBox[{"Table", "[", 
         RowBox[{
          RowBox[{"If", "[", 
           RowBox[{
            RowBox[{
             RowBox[{"Abs", "[", "ii", "]"}], ">", 
             RowBox[{"10", "^", 
              RowBox[{"(", 
               RowBox[{
                RowBox[{"-", "$MinPrecision"}], "/", "2"}], ")"}]}]}], ",", 
            "ii", ",", "0"}], "]"}], ",", 
          RowBox[{"{", 
           RowBox[{"ii", ",", "HessianEigenvaluesRaw"}], "}"}]}], "]"}]}], 
       ";", "\[IndentingNewLine]", 
       RowBox[{"JacobianValues", "=", 
        RowBox[{"Table", "[", 
         RowBox[{
          RowBox[{"If", "[", 
           RowBox[{
            RowBox[{
             RowBox[{"Abs", "[", "ii", "]"}], ">", 
             RowBox[{"10", "^", 
              RowBox[{"(", 
               RowBox[{
                RowBox[{"-", "$MinPrecision"}], "/", "2"}], ")"}]}]}], ",", 
            "ii", ",", "0"}], "]"}], ",", 
          RowBox[{"{", 
           RowBox[{"ii", ",", "JacobianValuesRaw"}], "}"}]}], "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"NumNegEigValsAfter", "=", 
        RowBox[{"Length", "[", 
         RowBox[{"Select", "[", 
          RowBox[{"HessianEigenvalues", ",", 
           RowBox[{
            RowBox[{"#", "<", "0"}], "&"}]}], "]"}], "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"(*", " ", 
        RowBox[{
        "Confirm", " ", "that", " ", "the", " ", "output", " ", "location", 
         " ", "is", " ", "a", " ", "local", " ", "minimum"}], " ", "*)"}], 
       "\[IndentingNewLine]", 
       RowBox[{"If", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"NumNegEigValsAfter", "\[Equal]", "0"}], "&&", 
          RowBox[{"AllTrue", "[", 
           RowBox[{"JacobianValues", ",", 
            RowBox[{
             RowBox[{
              RowBox[{"Abs", "[", "#", "]"}], "<", 
              RowBox[{"(", 
               RowBox[{"$MinPrecision", "/", "2"}], ")"}]}], "&"}]}], "]"}]}],
          ",", "\[IndentingNewLine]", 
         RowBox[{
          RowBox[{"Print", "[", "\"\<Optimization successful!\>\"", "]"}], 
          ";", "\[IndentingNewLine]", 
          RowBox[{"\[Theta]val", "=", 
           RowBox[{"LocalMinimum", "[", 
            RowBox[{"[", "2", "]"}], "]"}]}], ";"}]}], "\[IndentingNewLine]", 
        "]"}], ";"}]}], "\[IndentingNewLine]", "]"}], ";"}], 
   "*)"}]}]], "Input",
