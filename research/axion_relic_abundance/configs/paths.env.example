# Machine-specific locations. Copy to configs/paths.env (git-ignored) and edit, or point SHOROQ_PATHS at another copy.
# engine/run_*.sh, producers/run_*.sh and the test scripts source it through engine/common.sh, which checks the entries a stage
# needs and stops with a clear message if one is wrong.
#   engine only (existing spectra with DOCUMENTED_EXTERNAL vacuum evidence): PYTHON, JULIA_ANALYSIS, WORK
#   + producers, or VERIFY entries (theta = 0 inertia scan): CYAX_REPO, JULIA_VMM

# CYAxiverse.jl checkout. Leave empty to use the checkout that contains this directory (research/axion_relic_abundance/).
# Pinned revision: branch vmm, commit a5eacd8cd4a5905161cab239a461ba252c64e8e0 (the revision that produced the reference
# dataset); for byte-identical reproduction copy environment/julia_vmm/Manifest.toml to its root and run Pkg.instantiate()
# once. Any other revision, including this checkout, is refused unless ALLOW_OTHER_CYAX_COMMIT=1 is exported; results must
# then be re-validated (INTEGRATION_DESIGN.md, "Revision pin").
CYAX_REPO=

# Python 3.11 interpreter of an environment with CYTools 1.4.12 and environment/python_requirements.txt
# (numpy, scipy, h5py, pandas, mpmath, cvxopt, osqp, highspy, ...). MOSEK must NOT be active.
PYTHON=/path/to/cytools-env/bin/python

# Julia 1.12.7: CYAxiverse (stages 2-3: Julia read-back, spectra, vacua CLI, vacuum repair)
JULIA_VMM=/path/to/julia-1.12.7/bin/julia
# Optional JULIA_DEPOT_PATH for JULIA_VMM (colon-separated; the first entry must be writable). Empty = Julia default.
JULIA_VMM_DEPOT=

# Julia 1.8.4: relic abundance and theta analysis (stages 4-5), run with --project=environment/julia_analysis.
# 1.8.4 is the version of the frozen production run; byte-identical reproduction is demonstrated only with it.
JULIA_ANALYSIS=/path/to/julia-1.8.4/bin/julia
# Optional JULIA_DEPOT_PATH for JULIA_ANALYSIS. Empty = Julia default.
JULIA_ANALYSIS_DEPOT=

# Output root of a pipeline run (about 2.5 GB for the full sample). Stages refuse to overwrite existing outputs.
# An exported WORK environment variable takes precedence over this value (the regression tests use that).
WORK=/path/to/shoroq_run

# Parallel workers for G2, the geometry audit, the spectrum groups and the inertia scan
WORKERS=8
